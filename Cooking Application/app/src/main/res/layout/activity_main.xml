<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9F6"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ヘッダー：アプリ名と2つの切り替えタブ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="kikicook"
            android:textColor="#2D3A30"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E8ECE6"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btnTabVoice"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#FFFFFF"
                android:text="音声認識"
                android:textColor="#2D3A30"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTabRecommend"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@android:color/transparent"
                android:text="おすすめ"
                android:textColor="#6B756D"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ① 音声認識タブの画面 -->
    <LinearLayout
        android:id="@+id/layoutVoice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 2  声で伝える"
            android:textColor="#6B756D"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="何を作りたいですか？"
            android:textColor="#1E2620"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="使いたい材料や、食べたいものを\n自由に話してください。"
            android:textColor="#5A635C"
            android:textSize="14sp" />

        <!-- マイクボタン -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:contentDescription="音声入力"
            app:backgroundTint="#4A6B53"
            app:fabCustomSize="96dp"
            app:maxImageSize="40dp"
            app:srcCompat="@android:drawable/ic_btn_speak_now"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvVoiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="タップして話す"
            android:textColor="#2D3A30"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="たとえば「じゃがいもを使った20分でできる料理」"
            android:textColor="#8A948C"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ② おすすめタブの画面 -->
    <LinearLayout
        android:id="@+id/layoutRecommend"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvRecognizedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8ECE6"
            android:padding="12dp"
            android:text="認識した言葉：（未入力）"
            android:textColor="#2D3A30"
            android:textSize="13sp" />

        <!-- レシピカード -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvRecipeTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="調理時間：15分"
                    android:textColor="#4A6B53"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecipeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ほくほくじゃがいものバター醤油炒め"
                    android:textColor="#1E2620"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecipeIngredients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="材料：じゃがいも 2個、バター 10g、醤油 大さじ1"
                    android:textColor="#5A635C"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnStartCooking"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#4A6B53"
                    android:text="この料理を作る"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 調理手順エリア（「この料理を作る」押下後に表示） -->
        <LinearLayout
            android:id="@+id/layoutCookingStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvStepCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ステップ 1 / 3"
                android:textColor="#4A6B53"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStepDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="じゃがいもを一口大に切り、レンジで3分加熱します。"
                android:textColor="#1E2620"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnNextStep"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#2D3A30"
                android:text="次のステップへ"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>