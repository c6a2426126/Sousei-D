<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ kikicook"
            android:textColor="#54765B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="COOKING SUPPORT"
            android:textColor="#9B9B83"
            android:textSize="12sp"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/recipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="鶏肉と野菜のトマト煮"
            android:textColor="#333333"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="STEP 1 / 4"
            android:textColor="#54765B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="材料を切ります"
            android:textColor="#333333"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="8dp"
            android:text="鶏肉はひと口大に切ります。"
            android:textColor="#666666"
            android:textSize="17sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="30dp"
            android:background="#DDDDCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="音声アシスタント"
            android:textColor="#54765B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/voiceButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="🎤 音声で操作する"
            android:textSize="16sp"
            android:backgroundTint="#54765B"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/readButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:text="🔊 工程を読み上げる"
            android:textSize="15sp"
            android:backgroundTint="#E8EBDD"
            android:textColor="#405D46" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="25dp"
            android:background="#DDDDCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="経過時間"
            android:textColor="#777777"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/timerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="00:00"
            android:textColor="#333333"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="戻る"
                android:textColor="#54765B"
                android:backgroundTint="#E8EBDD" />

            <Button
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="次へ →"
                android:textColor="#FFFFFF"
                android:backgroundTint="#54765B" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
